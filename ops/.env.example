# Copy to ops/.env (gitignored) on each host. docker compose reads it for the
# ${...} values in docker-compose.yml. Every value below is required.

# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEBHOOK_SECRET_ENCRYPTION_KEY=
# Shared by api and settlement; any long random string.
SETTLEMENT_INTERNAL_TOKEN=
# From the acquirer. During a rotation: "new,old".
ACQUIRER_CALLBACK_SIGNING_SECRET=

# Optional: the public origin of the dashboard/checkout (the `web` service),
# no trailing slash. Payment-link URLs are built from it. Default
# http://localhost:8080.
# CHECKOUT_BASE_URL=https://pay.example.com
