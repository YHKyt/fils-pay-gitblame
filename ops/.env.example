# Copy to ops/.env (gitignored) on each host. docker compose reads it for the
# ${...} values in docker-compose.yml. The first five values are required:
# compose refuses to start while any of them is unset.

# Password for the `filspay` Postgres role. Letters and digits only (it is
# embedded in a connection URL), e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# It is set when the Postgres volume is first created; changing it later
# needs ALTER ROLE inside the database as well.
POSTGRES_PASSWORD=
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEBHOOK_SECRET_ENCRYPTION_KEY=
# Shared by api and settlement; any long random string.
SETTLEMENT_INTERNAL_TOKEN=
# From the acquirer. During a rotation: "new,old".
ACQUIRER_CALLBACK_SIGNING_SECRET=

# Public origin of the dashboard/checkout (the `web` service), no trailing
# slash. Payment-link URLs are built from it. Required; keep this value for a
# local stack, set the hosted https:// origin on the hosted box.
CHECKOUT_BASE_URL=http://localhost:8080

# Optional.
# Tag for the shared Node image (filspay-node:<tag>), default local.
# IMAGE_TAG=local
# Host ports (defaults 8080, 3000, 5432; Postgres is bound to 127.0.0.1).
# WEB_HOST_PORT=8080
# API_HOST_PORT=3000
# POSTGRES_HOST_PORT=5432
# Fraction of approved cards the acquirer simulator declines at random (default 0 here).
# ACQUIRER_FAILURE_RATE=0
# Return the login OTP in the login response. Demo/judging boxes only; see ops/README.md.
# OTP_DEV_EXPOSE=false
# Wipe and reseed on the next `up`. Destroys every merchant, ledger entry and admin user.
# SEED_RESET=1
