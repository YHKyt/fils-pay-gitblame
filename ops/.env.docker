# Local docker-compose environment — sandbox/dev only. Do not point this
# compose file at production infrastructure.
#
# NODE_ENV=production so local behaviour matches the hosted box (secure
# cookies, https-only webhook URLs). If cookies don't stick on plain http
# localhost, that's why. — MK
NODE_ENV=production
PORT=3000

# Secrets are NOT kept here: this file is tracked in git (the .gitignore entry
# `.env` does not match `.env.docker`). They come from ops/.env — copy
# ops/.env.example. The acquirer secret that used to be committed here is
# public in git history and must be rotated with the acquirer.
