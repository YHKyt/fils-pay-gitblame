# Browser front end: builds apps/web and apps/admin with Vite, then serves
# both static bundles from nginx, which also proxies /v1 to the api
# (ops/nginx.web.conf), so the browser only ever talks to one origin:
#   /            merchant dashboard and public checkout (apps/web)
#   /admin/      admin console (apps/admin)
#   /v1/, /healthz, /readyz   apps/api
FROM node:22-slim AS build

WORKDIR /app
ENV NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false

# Every workspace manifest is needed for `npm ci` to accept the lockfile.
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages/money/package.json packages/money/
COPY packages/events/package.json packages/events/
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/

# Only the two front-end workspaces' dependencies; --ignore-scripts skips
# native builds (argon2) that the static bundles never use.
RUN npm ci --include=dev --no-audit --ignore-scripts -w @filspay/web -w @filspay/admin \
 && npm cache clean --force

COPY packages/money ./packages/money
COPY apps/web ./apps/web
COPY apps/admin ./apps/admin
# Relative API base URLs: every call goes to the page's own origin.
# The admin console lives under /admin/; its "view as merchant" link opens
# the dashboard on the same origin.
RUN VITE_API_BASE_URL="" npm run build -w @filspay/web \
 && VITE_ADMIN_API_BASE_URL="" VITE_WEB_BASE_URL="/dashboard" \
    npm run build -w @filspay/admin -- --base=/admin/

FROM nginx:1.27-alpine
COPY ops/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY --from=build /app/apps/admin/dist /usr/share/nginx/html/admin
EXPOSE 8080
