{
  "$comment": "Reconstruction, not in use: least-privilege Claude Code permission rules covering the commands this member's sessions ran. Copy to .claude/settings.json to run the same workflow with prompts enabled.",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(apps/**)",
      "Edit(packages/**)",
      "Edit(db/**)",
      "Edit(docs/**)",
      "Edit(scripts/**)",
      "Edit(ops/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git revert:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin b/*)",
      "Bash(git worktree:*)",
      "Bash(npm ci)",
      "Bash(npm run migrate)",
      "Bash(npm run seed)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run build:*)",
      "Bash(npx tsx --test:*)",
      "Bash(npx vite:*)",
      "Bash(go test:*)",
      "Bash(node docs/ai/b-setup/scripts/*)"
